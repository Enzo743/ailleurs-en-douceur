DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ailleurs_en_douceur?schema=public"

# Mot de passe unique de l'administrateur
ADMIN_PASSWORD="change-me"

# Clé secrète JWT — générer avec : openssl rand -base64 32
JWT_SECRET="generate-with-openssl-rand-base64-32"

DOMAIN="test.com"

# Configuration Nodemailer pour l'envoi d'emails
# ============================================

# Option 1: Configuration SMTP standard (Gmail, etc.)
# Exemple avec Gmail (nécessite un "App Password" si 2FA est activé)
EMAIL_USER="votre-email@gmail.com"
EMAIL_PASS="votre-mot-de-passe-ou-app-password"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_FROM="votre-email@gmail.com"  # Adresse email vérifiée de l'expéditeur

# Option 2: Configuration Brevo (ex-Sendinblue) - RECOMMANDÉ
# ============================================
# Méthode A: Avec identifiants SMTP spécifiques (recommandé par Brevo)
# 1. Allez dans Brevo > Paramètres > SMTP
# 2. Copiez les identifiants SMTP fournis (utilisateur@smtp-brevo.com + mot de passe)
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="votre-utilisateur@smtp-brevo.com"
BREVO_SMTP_PASS="votre-mot-de-passe-smtp"

# Méthode B: Avec API key (alternative)
# 1. Allez dans Brevo > Paramètres > API Keys
# 2. Créer une API key avec permissions SMTP
BREVO_API_KEY="votre-api-key-brevo"

# Configuration commune pour Brevo
BREVO_SENDER_EMAIL="votre-email@domaine.com"  # Doit être vérifié dans Brevo
EMAIL_FROM="votre-email@domaine.com"  # Doit correspondre à BREVO_SENDER_EMAIL

# Email du destinataire (optionnel - par défaut: EMAIL_USER ou BREVO_SENDER_EMAIL)
CONTACT_RECIPIENT_EMAIL="email-de-votre-cliente@domaine.com"

# Base URL de l'application (pour générer les liens dans les emails)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ============================================
# Google OAuth2 pour Calendar API
# ============================================
# 1. Créer un projet sur https://console.cloud.google.com/
# 2. Activer l'API Google Calendar
# 3. Créer des identifiants OAuth2 (type "Application web")
# 4. Ajouter l'URI de redirection autorisée

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
GOOGLE_CALENDAR_ID="primary"  # ou l'ID spécifique de votre calendrier

# (Optionnel) Clé de service pour l'authentification server-to-server
# Alternative à OAuth2 pour les environnements de production
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
GOOGLE_SERVICE_ACCOUNT_SUBJECT="adresse@mail.com"

# Cron secret clé
CRON_SECRET="generate-with-openssl-rand-base64-32"

# ==========================================
# Umami Analytics Configuration (Auto-hébergé)
# ==========================================
# 1. Installez Umami sur votre VPS (Docker recommandé)
# 2. Créez un site dans votre instance Umami et récupérez l'ID
# 3. Créez un utilisateur Umami avec username/password pour l'API

# ID de votre site Umami (trouvé dans Paramètres > Websites)
UMAMI_WEBSITE_ID="votre-id-de-site-umami"

# URL de base de Umami (sans /api)
UMAMI_API_URL="https://analytics.ailleurs-en-douceur.com"

# Variables publiques pour le script Umami (accessibles côté client)
# Utilisées pour le tracking sur le site public (exclut /dashboard)
NEXT_PUBLIC_UMAMI_WEBSITE_ID="votre-id-de-site-umami"
NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://analytics.ailleurs-en-douceur.com/script.js"

# Identifiants pour l'authentification API Umami (auto-hébergé)
# Utilisé pour obtenir un token d'authentification pour récupérer les stats
UMAMI_USERNAME="votre-utilisateur-umami"
UMAMI_PASSWORD="votre-mot-de-passe-umami"